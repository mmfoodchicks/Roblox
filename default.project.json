{
  "name": "IncrementalFishingSimulator",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",

      "FishingNetwork": {
        "$className": "RemoteEvent"
      },
      "DataNetwork": {
        "$className": "RemoteEvent"
      },
      "ShopFunction": {
        "$className": "RemoteFunction"
      },

      "Shared": {
        "$className": "Folder",
        "LootManager": {
          "$path": "src/Shared/LootManager.luau"
        },
        "GameConfig": {
          "$path": "src/Shared/GameConfig.luau"
        },
        "MonetizationConfig": {
          "$path": "src/Shared/MonetizationConfig.luau"
        }
      },

      "Packages": {
        "$className": "Folder",
        "ProfileService": {
          "$path": "src/ReplicatedStorage/ProfileService.luau"
        }
      }
    },

    "ServerScriptService": {
      "$className": "ServerScriptService",

      "ServerBootstrap": {
        "$path": "src/Server/ServerBootstrap.server.luau"
      },

      "Services": {
        "$className": "Folder",
        "DataService": {
          "$path": "src/Server/Services/DataService.luau"
        },
        "FishingService": {
          "$path": "src/Server/Services/FishingService.luau"
        },
        "ShopService": {
          "$path": "src/Server/Services/ShopService.luau"
        },
        "MonetizationService": {
          "$path": "src/Server/Services/MonetizationService.luau"
        },
        "LeaderstatsService": {
          "$path": "src/Server/Services/LeaderstatsService.luau"
        },
        "RodToolBuilder": {
          "$path": "src/Server/Services/RodToolBuilder.luau"
        },
        "MapBuilder": {
          "$path": "src/Server/Services/MapBuilder.luau"
        }
      }
    },

    "StarterPlayer": {
      "$className": "StarterPlayer",

      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",

        "ClientBootstrap": {
          "$path": "src/Client/ClientBootstrap.client.luau"
        },

        "Controllers": {
          "$className": "Folder",
          "UiUtil": {
            "$path": "src/Client/Controllers/UiUtil.luau"
          },
          "DataController": {
            "$path": "src/Client/Controllers/DataController.luau"
          },
          "HudController": {
            "$path": "src/Client/Controllers/HudController.luau"
          },
          "ShopController": {
            "$path": "src/Client/Controllers/ShopController.luau"
          },
          "InventoryController": {
            "$path": "src/Client/Controllers/InventoryController.luau"
          },
          "StoreController": {
            "$path": "src/Client/Controllers/StoreController.luau"
          },
          "FishingController": {
            "$path": "src/Client/Controllers/FishingController.luau"
          }
        }
      }
    },

    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "FilteringEnabled": true
      }
    }
  }
}
